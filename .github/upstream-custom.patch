+// callRunningHubTask executes the task-based RunningHub contract used by AI
+// Apps, workflows and ComfyUI. A monitor run deliberately submits one small
+// configured task, then polls status/output until completion. The request body
+// is supplied through body_override so each workflow can keep its own inputs.
+func callRunningHubTask(ctx context.Context, endpoint, apiKey, model, apiMode string, opts *CheckOptions) (string, string, int, error) {
+	if opts == nil || len(opts.BodyOverride) == 0 {
+		return "", "", 0, fmt.Errorf("runninghub task monitor requires body_override with the task inputs")
+	}
+	bodyMap := cloneAnyMap(opts.BodyOverride)
+	if _, ok := bodyMap["apiKey"]; !ok {
+		bodyMap["apiKey"] = apiKey
+	}
+	if _, ok := bodyMap["workflowId"]; !ok && (apiMode == MonitorAPIModeRunningHubWorkflow || apiMode == MonitorAPIModeRunningHubComfyUI) {
+		bodyMap["workflowId"] = model
+	}
+	if _, ok := bodyMap["webappId"]; !ok && apiMode == MonitorAPIModeRunningHubAIApp {
+		bodyMap["webappId"] = model
+	}
+	path := "/task/openapi/create"
+	if apiMode == MonitorAPIModeRunningHubAIApp {
+		path = "/task/openapi/ai-app/run"
+	}
+	headers := map[string]string{"Authorization": "Bearer " + apiKey}
+	headers = mergeHeaders(headers, opts)
+	payload, err := json.Marshal(bodyMap)
+	if err != nil {
+		return "", "", 0, fmt.Errorf("marshal runninghub task body: %w", err)
+	}
+	respBody, status, err := postRawJSON(ctx, joinURL(endpoint, path), payload, headers)
+	if err != nil {
+		return "", string(respBody), status, err
+	}
+	if status < 200 || status >= 300 {
+		return "", string(respBody), status, nil
+	}
+	if code := gjson.GetBytes(respBody, "code"); code.Exists() && code.Int() != 0 {
+		return "", string(respBody), status, nil
+	}
+	taskID := strings.TrimSpace(gjson.GetBytes(respBody, "data.taskId").String())
+	if taskID == "" {
+		return "", string(respBody), status, fmt.Errorf("runninghub task response did not contain taskId")
+	}
+
+	deadline := time.NewTimer(35 * time.Second)
+	defer deadline.Stop()
+	ticker := time.NewTicker(2 * time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return "", string(respBody), status, ctx.Err()
+		case <-deadline.C:
+			return "", string(respBody), http.StatusGatewayTimeout, nil
+		case <-ticker.C:
+			statusBody, statusCode, statusErr := runningHubTaskRequest(ctx, endpoint, apiKey, "/task/openapi/status", taskID, headers)
+			if statusErr != nil {
+				return "", string(statusBody), statusCode, statusErr
+			}
+			if statusCode < 200 || statusCode >= 300 {
+				return "", string(statusBody), statusCode, nil
+			}
+			state := strings.ToUpper(strings.TrimSpace(gjson.GetBytes(statusBody, "data").String()))
+			if runningHubTaskFailed(state) {
+				return "", string(statusBody), http.StatusBadGateway, nil
+			}
+			outputBody, outputCode, outputErr := runningHubTaskRequest(ctx, endpoint, apiKey, "/task/openapi/outputs", taskID, headers)
+			if outputErr != nil {
+				return "", string(outputBody), outputCode, outputErr
+			}
+			if outputCode < 200 || outputCode >= 300 {
+				return "", string(outputBody), outputCode, nil
+			}
+			if gjson.GetBytes(outputBody, "code").Int() != 0 {
+				return "", string(outputBody), http.StatusBadGateway, nil
+			}
+			if gjson.GetBytes(outputBody, "data").IsArray() && len(gjson.GetBytes(outputBody, "data").Array()) > 0 {
+				return "runninghub task completed", string(outputBody), outputCode, nil
+			}
+			if state == "SUCCESS" || state == "COMPLETED" || state == "FINISHED" {
+				return "runninghub task completed", string(outputBody), outputCode, nil
+			}
+		}
+	}
+}
+
+func runningHubTaskRequest(ctx context.Context, endpoint, apiKey, path, taskID string, headers map[string]string) ([]byte, int, error) {
+	payload, err := json.Marshal(map[string]string{"apiKey": apiKey, "taskId": taskID})
+	if err != nil {
+		return nil, 0, err
+	}
+	return postRawJSON(ctx, joinURL(endpoint, path), payload, headers)
+}
+
+func runningHubTaskFailed(state string) bool {
+	switch state {
+	case "FAILED", "ERROR", "CANCELED", "CANCELLED", "TIMEOUT":
+		return true
+	default:
+		return false
+	}
+}
+
+func cloneAnyMap(in map[string]any) map[string]any {
+	out := make(map[string]any, len(in)+2)
+	for k, v := range in {
+		out[k] = v
+	}
+	return out
+}
